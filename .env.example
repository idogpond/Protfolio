# ─────────────────────────────────────────
# Docker Compose Root Environment Variables
# ─────────────────────────────────────────

# Database
DB_DATABASE=portfolio_db
DB_USERNAME=portfolio_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# Admin account (seeded on startup). Change this before exposing the app
# publicly (e.g. via the Cloudflare Tunnel below) — the default is not secure.
ADMIN_EMAIL=admin@portfolio.com
ADMIN_PASSWORD=password

# Cloudflare Tunnel
# 1. Create a named tunnel in Cloudflare Zero Trust → Networks → Tunnels
# 2. Set the tunnel service to http://frontend:3000
# 3. Paste the tunnel token and your assigned <uuid>.cfargotunnel.com URL below
# 4. Update CORS_ALLOWED_ORIGINS, SANCTUM_STATEFUL_DOMAINS and SESSION_DOMAIN
#    to match the public domain, and switch APP_ENV/APP_DEBUG to production
#    values (see below)
# 5. Start with: docker compose --profile tunnel up -d
TUNNEL_TOKEN=
PUBLIC_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Backend runtime (switch these when deploying for real; leave as-is for
# local dev). SANCTUM_STATEFUL_DOMAINS/SESSION_DOMAIN must match the public
# domain the frontend is served from, or admin login will break.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost

# Contact form email notifications (via Resend SMTP: https://resend.com)
# 1. Sign up at resend.com, create an API key
# 2. Paste it below as MAIL_PASSWORD
# 3. Set MAIL_MAILER=smtp to actually send (otherwise mail is only logged)
# Notifications are sent to the email set in the admin Profile settings.
MAIL_MAILER=log
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="Portfolio Contact Form"
